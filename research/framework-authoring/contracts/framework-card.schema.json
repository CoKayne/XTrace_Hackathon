{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsee.example/schemas/framework-card-authoring-v1.json",
  "title": "Framework Card Authoring Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frameworkId",
    "slug",
    "name",
    "version",
    "positioning",
    "attribution",
    "neutralParaphrase",
    "claimTypes",
    "sourceRefs",
    "applicability",
    "requiredConditions",
    "requiredEvidence",
    "decisionQuestions",
    "positiveSignals",
    "redFlags",
    "disconfirmingEvidence",
    "contraindications",
    "decisionMethod",
    "confidenceAnchors",
    "overlapFrameworkIds",
    "conflictingFrameworkIds",
    "decisionUtility",
    "rights",
    "review",
    "changeLog"
  ],
  "properties": {
    "schemaVersion": {
      "const": "framework-card-authoring-v1"
    },
    "frameworkId": {
      "type": "string",
      "pattern": "^[A-Z0-9]+-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oneLineSummary",
        "productLabel",
        "notAClaimOf"
      ],
      "properties": {
        "oneLineSummary": {
          "type": "string",
          "minLength": 1
        },
        "productLabel": {
          "type": "string",
          "minLength": 1
        },
        "notAClaimOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "scope",
        "people",
        "organizations",
        "fidelityConfidence"
      ],
      "properties": {
        "display": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "person_direct",
            "coauthored_work",
            "course_notes_derivative",
            "institution_doctrine",
            "revealed_behavior",
            "product_synthesis"
          ]
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "organizations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fidelityConfidence": {
          "enum": [
            "low",
            "medium",
            "medium_high",
            "high"
          ]
        }
      }
    },
    "neutralParaphrase": {
      "type": "string",
      "minLength": 1
    },
    "claimTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "direct_doctrine",
          "affiliated_doctrine",
          "revealed_behavior",
          "historical_description",
          "empirical_association",
          "normative_guidance",
          "contractual_convention",
          "product_inference",
          "empirical_qualification"
        ]
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "applicability": {
      "$ref": "#/$defs/applicability"
    },
    "requiredConditions": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRequirement"
      }
    },
    "decisionQuestions": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "positiveSignals": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "redFlags": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "disconfirmingEvidence": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "contraindications": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "decisionMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instructions",
        "outputOrder",
        "deterministicRule"
      ],
      "properties": {
        "kind": {
          "enum": [
            "qualitative_lens",
            "ordinal_anchors",
            "deterministic_rule",
            "hybrid"
          ]
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputOrder": {
          "const": [
            "evidence",
            "applicable_rule",
            "judgment",
            "counterevidence",
            "unknowns",
            "conclusion",
            "next_evidence_request"
          ]
        },
        "deterministicRule": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        }
      }
    },
    "confidenceAnchors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceReliability",
        "evidenceStrength",
        "evidenceCoverage",
        "applicabilityConfidence",
        "judgmentConfidence"
      ],
      "properties": {
        "sourceReliability": {
          "$ref": "#/$defs/anchorScale"
        },
        "evidenceStrength": {
          "$ref": "#/$defs/anchorScale"
        },
        "evidenceCoverage": {
          "$ref": "#/$defs/anchorScale"
        },
        "applicabilityConfidence": {
          "$ref": "#/$defs/anchorScale"
        },
        "judgmentConfidence": {
          "$ref": "#/$defs/anchorScale"
        }
      }
    },
    "overlapFrameworkIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "conflictingFrameworkIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "decisionUtility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "formalDecisionWeight",
        "allowedUses",
        "promotionRequirements",
        "empiricalQualifications"
      ],
      "properties": {
        "status": {
          "enum": [
            "advisory",
            "candidate",
            "validated_decision_factor",
            "retired"
          ]
        },
        "formalDecisionWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allowedUses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "research_question",
              "watch_rationale",
              "advance_rationale",
              "invest_candidate_gate",
              "veto",
              "portfolio_policy"
            ]
          }
        },
        "promotionRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "empiricalQualifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "displayMode",
        "containsLongQuote",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending_review",
            "public_source_paraphrase",
            "licensed",
            "public_domain",
            "restricted",
            "rejected"
          ]
        },
        "displayMode": {
          "enum": [
            "neutral_paraphrase_only",
            "short_quote_and_paraphrase",
            "internal_locator_only"
          ]
        },
        "containsLongQuote": {
          "const": false
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentStatus",
        "publicationStatus",
        "reviewer",
        "reviewedAt",
        "openIssues"
      ],
      "properties": {
        "contentStatus": {
          "enum": [
            "draft",
            "review_ready",
            "approved",
            "rejected"
          ]
        },
        "publicationStatus": {
          "enum": [
            "unpublished",
            "published",
            "retired"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "openIssues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "changeLog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date",
          "summary"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "claimIds",
        "locator",
        "attributionScope",
        "supportType"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "claimIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "chapter_page",
                "pdf_page",
                "ebook_location",
                "video_timestamp",
                "web_section"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "attributionScope": {
          "enum": [
            "person_direct",
            "coauthored_work",
            "course_notes_derivative",
            "institution_doctrine",
            "revealed_behavior",
            "external_empirical"
          ]
        },
        "supportType": {
          "enum": [
            "primary",
            "corroborating",
            "qualification",
            "conflict",
            "counterexample"
          ]
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "businessModels",
        "sectors",
        "geographies",
        "securityTypes"
      ],
      "properties": {
        "stages": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "businessModels": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "sectors": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "geographies": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "securityTypes": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceKey",
        "description",
        "necessity",
        "acceptableSources",
        "missingEffect"
      ],
      "properties": {
        "evidenceKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "necessity": {
          "enum": [
            "required",
            "recommended",
            "optional"
          ]
        },
        "acceptableSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missingEffect": {
          "enum": [
            "not_applicable",
            "insufficient_evidence",
            "lower_confidence",
            "no_effect"
          ]
        }
      }
    },
    "anchorScale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "medium",
        "high"
      ],
      "properties": {
        "low": {
          "type": "string",
          "minLength": 1
        },
        "medium": {
          "type": "string",
          "minLength": 1
        },
        "high": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

